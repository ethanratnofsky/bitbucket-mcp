# Copy to .env (or set these in your MCP client config) and fill in real values.
# Create a scoped API token at: https://id.atlassian.com/manage-profile/security/api-tokens
#
# Scopes (product: Bitbucket) — select each one; scoped tokens do NOT imply one
# scope from another, so a partial set causes 403s:
#   Read + comment: read:repository:bitbucket  read:pullrequest:bitbucket  read:workspace:bitbucket
#                   (reads, plus posting / editing / resolving comments — not read-only)
#   Read + write  : add  write:pullrequest:bitbucket   (review actions + create/update PR)
# (read:repository is required for the diff tool — its endpoint redirects to a
#  repository-level URL — and for file/branch/repo reads.)
# Grant the token access to only the repositories you need, and set an expiry.
ATLASSIAN_USER_EMAIL=you@company.com
ATLASSIAN_API_TOKEN=ATATT_your_scoped_token

# Optional: per-request timeout in milliseconds (default 30000).
# BITBUCKET_TIMEOUT_MS=30000
